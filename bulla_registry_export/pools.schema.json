{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/bulla-network/factoring-contracts/bulla_registry_export/pools.schema.json",
    "title": "Bulla factoring pools",
    "description": "Every Bulla factoring pool on every chain, and the clients they belong to. Published through bulla-registry. Rules JSON Schema can't express (unique addresses, known clients, which fields each version has, supersededBy targets, one current pool per poolKey and chain) are checked by scripts/validate-pools.ts.",
    "type": "object",
    "additionalProperties": false,
    "required": ["clients", "pools"],
    "properties": {
        "$schema": { "type": "string" },
        "clients": {
            "type": "object",
            "description": "Keyed by client key, e.g. tcs. A client is who the pool factors invoices for; one client can have many pools.",
            "propertyNames": { "$ref": "#/definitions/key" },
            "additionalProperties": { "$ref": "#/definitions/client" }
        },
        "pools": {
            "type": "array",
            "items": { "$ref": "#/definitions/pool" }
        }
    },
    "definitions": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "client": {
            "type": "object",
            "additionalProperties": false,
            "required": ["displayName"],
            "properties": {
                "displayName": { "type": "string", "minLength": 1 },
                "website": { "type": "string", "pattern": "^https://" },
                "logo": {
                    "type": "string",
                    "description": "An https URL, or a path relative to this file (e.g. logos/tcs.png). Absent: show the Bulla logo.",
                    "pattern": "^(https://|logos/)"
                }
            }
        },
        "network": { "type": "string", "enum": ["mainnet", "sepolia", "polygon", "base", "arbitrum", "redbelly", "xdc"] },
        "category": {
            "type": "string",
            "description": "Where the app lists the pool. active: live, on the Active tab. test: a test pool, on the Test tab. archived: no longer in use; on the Archived tab and not offered when batch factoring. hidden: on no tab and not offered when batch factoring, and its details page shows nothing of it, e.g. a bad deploy that a redeploy replaced. A pool superseded by a redeploy is archived or hidden, as its redeploy's pending entry says (replaces). deprecated: a record of a pool no consumer can read, because its contract has the interface of no version (e.g. a pre-release test deploy); bulla-registry leaves it out of registry.json, so no consumer sees it, and it is never a poolKey's current pool.",
            "enum": ["active", "test", "archived", "hidden", "deprecated"]
        },
        "shareToken": {
            "type": "object",
            "description": "The pool's own ERC-20 share token. Its address is the pool address.",
            "additionalProperties": false,
            "required": ["symbol", "name", "decimals"],
            "properties": {
                "symbol": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "decimals": { "type": "integer", "minimum": 0, "maximum": 36 }
            }
        },
        "asset": {
            "type": "object",
            "description": "The underlying asset the pool takes deposits in and funds invoices with.",
            "additionalProperties": false,
            "required": ["address", "symbol", "name", "decimals", "kind"],
            "properties": {
                "address": { "$ref": "#/definitions/address" },
                "symbol": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "decimals": { "type": "integer", "minimum": 0, "maximum": 36 },
                "kind": { "type": "string", "enum": ["stable", "volatile"] }
            }
        },
        "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["factoring", "deposit"],
            "properties": {
                "factoring": { "$ref": "#/definitions/address" },
                "deposit": { "$ref": "#/definitions/address" },
                "redeem": {
                    "$ref": "#/definitions/address",
                    "description": "Absent on V0 and V1 pools, which have no redeem permissions; present from V2.1 on."
                }
            }
        },
        "fees": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocolBps", "adminBps", "targetYieldBps"],
            "properties": {
                "protocolBps": { "$ref": "#/definitions/bps" },
                "adminBps": { "$ref": "#/definitions/bps" },
                "targetYieldBps": { "$ref": "#/definitions/bps" },
                "insuranceBps": {
                    "$ref": "#/definitions/bps",
                    "description": "Absent before V2.2, which has no insurance fee; present on every V2.2 pool."
                }
            }
        },
        "pool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "chainId",
                "network",
                "address",
                "version",
                "client",
                "displayName",
                "category",
                "shareToken",
                "asset",
                "insured",
                "enforceKyc",
                "permissions",
                "underwriter",
                "fees",
                "deployBlock"
            ],
            "properties": {
                "chainId": { "type": "integer", "minimum": 1 },
                "network": { "$ref": "#/definitions/network" },
                "address": { "$ref": "#/definitions/address", "description": "The pool contract, which is also its share token." },
                "version": { "type": "string", "enum": ["V0", "V1", "V2_1", "V2_2"] },
                "client": { "$ref": "#/definitions/key", "description": "A key of clients. Separate from poolKey: tcs-wyoming is client tcs." },
                "poolKey": {
                    "$ref": "#/definitions/key",
                    "description": "The name the deploy scripts take (network-config.ts), e.g. tcs-wyoming. A redeploy keeps the poolKey, so several pools on a chain can share one, but only one of them is current (no supersededBy); the rest form its history. Only pools those scripts manage have one."
                },
                "displayName": { "type": "string", "minLength": 1 },
                "category": { "$ref": "#/definitions/category" },
                "supersededBy": {
                    "$ref": "#/definitions/address",
                    "description": "The pool on the same chain, with the same poolKey, that replaced this one when it was redeployed: the next deploy, not the latest, so each pool is superseded by at most one and replaces at most one."
                },
                "shareToken": { "$ref": "#/definitions/shareToken" },
                "asset": { "$ref": "#/definitions/asset" },
                "insured": { "type": "boolean" },
                "enforceKyc": { "type": "boolean" },
                "permissions": { "$ref": "#/definitions/permissions" },
                "underwriter": { "$ref": "#/definitions/address" },
                "fees": { "$ref": "#/definitions/fees" },
                "deployBlock": { "type": "integer", "minimum": 0, "description": "The block that created the pool; the subgraph's start block for it." }
            }
        },
        "pendingPoolsFile": {
            "description": "scripts/pending-pools.json: pools to deploy next. The deploy moves an entry into pools.json once it is live.",
            "type": "object",
            "additionalProperties": false,
            "required": ["pools"],
            "properties": {
                "$schema": { "type": "string" },
                "pools": { "type": "array", "items": { "$ref": "#/definitions/pendingPool" } }
            }
        },
        "pendingPool": {
            "type": "object",
            "additionalProperties": false,
            "required": ["network", "poolKey", "client", "displayName", "category", "shareToken", "asset", "insured", "enforceKyc", "underwriter", "fees"],
            "properties": {
                "network": { "$ref": "#/definitions/network" },
                "poolKey": { "$ref": "#/definitions/key" },
                "replaces": {
                    "type": "string",
                    "enum": ["archived", "hidden"],
                    "description": "Required when pools.json already has a current pool for this network and poolKey (a redeploy), and absent otherwise: the category the deploy gives the pool it replaces. hidden for a bad deploy nobody should see; archived for a pool whose history should stay on the Archived tab."
                },
                "client": { "$ref": "#/definitions/key" },
                "displayName": { "type": "string", "minLength": 1 },
                "category": { "$ref": "#/definitions/category" },
                "shareToken": {
                    "type": "object",
                    "description": "Decimals follow the asset's.",
                    "additionalProperties": false,
                    "required": ["symbol", "name"],
                    "properties": {
                        "symbol": { "type": "string", "minLength": 1 },
                        "name": { "type": "string", "minLength": 1 }
                    }
                },
                "asset": { "$ref": "#/definitions/asset" },
                "insured": { "type": "boolean" },
                "enforceKyc": { "type": "boolean" },
                "permissions": {
                    "type": "object",
                    "description": "Existing permissions contracts to reuse. Any left out is deployed with the pool.",
                    "additionalProperties": false,
                    "properties": {
                        "factoring": { "$ref": "#/definitions/address" },
                        "deposit": { "$ref": "#/definitions/address" },
                        "redeem": { "$ref": "#/definitions/address" }
                    }
                },
                "underwriter": { "$ref": "#/definitions/address" },
                "fees": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["protocolBps", "adminBps", "targetYieldBps"],
                    "properties": {
                        "protocolBps": { "$ref": "#/definitions/bps" },
                        "adminBps": { "$ref": "#/definitions/bps" },
                        "targetYieldBps": { "$ref": "#/definitions/bps" },
                        "insuranceBps": { "$ref": "#/definitions/bps", "description": "Left out: the deploy script's default (100)." }
                    }
                }
            }
        }
    }
}
